# EVM Configuration (Base + Base Sepolia)
# Required for EVM payments
EVM_PRIVATE_KEY=0x...your-private-key-here

# SVM Configuration (Solana Devnet)
# Optional - only needed for Solana payments
SVM_PRIVATE_KEY=...your-solana-private-key-here
SVM_RPC_URL=https://api.devnet.solana.com

# Witness Verification
# Set to "true" to require witness binding on all payments
# Set to "false" or omit to make witness optional
WITNESS_REQUIRED=false

# Server Configuration
PORT=3000
NODE_ENV=development

# Example RPC URLs for different networks:
# Base Sepolia: https://sepolia.base.org
# Base Mainnet: https://mainnet.base.org
# Solana Devnet: https://api.devnet.solana.com
# Solana Mainnet: https://api.mainnet-beta.solana.com
